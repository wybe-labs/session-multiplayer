{
  "name": "session-multiplayer",
  "version": "0.3.0",
  "description": "Serverless P2P session multiplayer for AI coding agents — one MCP server, any harness: Claude Code, Codex, or anything that speaks MCP",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "register": "node adapters/register.js",
    "register:claude": "node adapters/claude-code/register.js",
    "register:codex": "node adapters/codex/register.js",
    "test": "node test/scope.js && node test/smoke.js",
    "test:security": "node test/security.js",
    "test:live": "node test/live.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wybe-labs/session-multiplayer.git"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.0",
    "b4a": "^1.6.6",
    "hypercore-crypto": "^3.4.2",
    "hyperdht": "^6.15.0",
    "hyperswarm": "^4.8.0",
    "sodium-universal": "^4.0.1",
    "zod": "^3.23.8"
  },
  "engines": {
    "node": ">=18"
  }
}
