# Kopier til .env. Ingen av disse er påkrevd lokalt: uten dem brukes
# PGlite i minnet, falskt kjøretøyregister, mock betaling og mock SMS.

NODE_ENV=development
PORT=8080

# «memory» for PGlite i minnet, «pglite:./data» for fil, ellers postgres-URL.
DATABASE_URL=memory

# Må settes i drift. Minst 16 tegn.
JWT_HEMMELIGHET=bare-til-utvikling-bytt-denne-i-drift
KODE_PEPPER=skodd-pepper-utvikling

# Fast engangskode til demo. Ignoreres alltid når NODE_ENV=production.
UTVIKLING_FAST_KODE=

# Statens vegvesen, enkeltoppslag på kjennemerke.
SVV_API_NOKKEL=

# Stripe: depositum via Checkout, månedspris via Subscriptions.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# SMS-leverandør (Sveve, Link Mobility eller tilsvarende).
SMS_URL=
SMS_NOKKEL=
